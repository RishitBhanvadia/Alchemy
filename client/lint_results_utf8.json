[{"filePath":"C:\\Users\\rishit\\OneDrive\\Desktop\\Project\\Alchemistry - Antigravity\\Alchemistry-master\\client\\src\\App.jsx","messages":[{"ruleId":"no-unused-vars","severity":2,"message":"'motion' is defined but never used.","line":4,"column":10,"nodeType":"Identifier","messageId":"unusedVar","endLine":4,"endColumn":16},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":61,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":61,"endColumn":18,"suggestions":[{"messageId":"removeConsole","data":{"propertyName":"log"},"fix":{"range":[2884,2954],"text":""},"desc":"Remove the console.log()."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { Routes, Route, useLocation, useNavigate, Navigate } from 'react-router-dom';\r\nimport { Toaster } from 'react-hot-toast';\r\nimport { lazy, Suspense, useEffect } from 'react';\r\nimport { motion, AnimatePresence } from 'framer-motion';\r\nimport Navbar from \"./components/Navbar\";\r\nimport CursorFollower from \"./components/CursorFollower\";\r\nimport ErrorBoundary from \"./components/ErrorBoundary\";\r\nimport LoadingOverlay from \"./components/LoadingOverlay\";\r\nimport { LabSkeleton, DashboardSkeleton } from \"./components/SkeletonLoader\";\r\nimport { PrivateRoute, RoleRoute } from './utils/roleGuard';\r\nimport \"./app.css\";\r\nimport \"./accessibility.css\";\r\n\r\n// Lazy load pages for better performance\r\nconst Lab = lazy(() => import(\"./pages/lab\"));\r\nconst Lab3D = lazy(() => import(\"./pages/Lab3D\"));\r\nconst Landing = lazy(() => import(\"./pages/Landing\"));\r\nconst Login = lazy(() => import(\"./pages/Login\"));\r\nconst StudentDashboard = lazy(() => import(\"./pages/StudentDashboard\"));\r\nconst Result = lazy(() => import(\"./pages/result\"));\r\nconst Organic = lazy(() => import(\"./pages/organic\"));\r\nconst Titration = lazy(() => import(\"./pages/titration\"));\r\nconst Inorganic = lazy(() => import(\"./pages/inorganic\"));\r\nconst History = lazy(() => import(\"./pages/history\"));\r\nconst Profile = lazy(() => import(\"./pages/Profile\"));\r\nconst Success = lazy(() => import(\"./pages/success\"));\r\nconst TeacherDashboard = lazy(() => import(\"./pages/TeacherDashboard\"));\r\nconst ClassroomDetail = lazy(() => import(\"./pages/ClassroomDetail\"));\r\n\r\nimport useAuthStore from './store/authStore';\r\n\r\n// Redirect root to correct dashboard based on role\r\nfunction RootRedirect() {\r\n  const profile = useAuthStore(state => state.profile);\r\n  const user = useAuthStore(state => state.user);\r\n  const loading = useAuthStore(state => state.loading);\r\n  if (loading) return <LoadingOverlay />;\r\n  // If no user, show Landing page\r\n  if (!user) return <Suspense fallback={<LoadingOverlay />}><Landing /></Suspense>;\r\n  // If profile is still null after loading, redirect to login (auth without profile)\r\n  if (!profile) return <Navigate to=\"/login\" replace />;\r\n  return <Navigate to={(profile.role === 'teacher' || profile.role === 'admin') ? '/teacher' : '/student'} replace />;\r\n}\r\n\r\nfunction App() {\r\n  const init = useAuthStore(state => state.init);\r\n  const loading = useAuthStore(state => state.loading);\r\n  const user = useAuthStore(state => state.user);\r\n  const profile = useAuthStore(state => state.profile);\r\n  const location = useLocation();\r\n  const navigate = useNavigate();\r\n\r\n  useEffect(() => {\r\n    init();\r\n  }, [init]);\r\n\r\n  useEffect(() => {\r\n    // Only redirect if everything is loaded and we are on /login\r\n    if (!loading && user && profile && location.pathname === '/login') {\r\n      const target = (profile.role === 'teacher' || profile.role === 'admin') ? '/teacher' : '/student';\r\n      console.log('Redirecting to:', target, 'Profile role:', profile.role);\r\n      navigate(target, { replace: true });\r\n    }\r\n  }, [user, profile, loading, location.pathname, navigate]);\r\n\r\n  const showNavbar = location.pathname !== '/' && location.pathname !== '/login';\r\n\r\n  if (loading) {\r\n    return <LoadingOverlay />; \r\n  }\r\n\r\n  return (\r\n    <ErrorBoundary>\r\n      <div className=\"App\">\r\n        <CursorFollower />\r\n        {showNavbar && <Navbar />}\r\n        <Toaster />\r\n\r\n        <AnimatePresence mode=\"wait\">\r\n          <Routes location={location} key={location.pathname}>\r\n          {/* Public Routes */}\r\n          <Route path=\"/\" element={<RootRedirect />} />\r\n          <Route path=\"/login\" element={<Suspense fallback={<LoadingOverlay />}><Login /></Suspense>} />\r\n\r\n          {/* Student-only routes */}\r\n          <Route path=\"/student\" element={\r\n            <PrivateRoute>\r\n              <RoleRoute requiredRole=\"student\">\r\n                <Suspense fallback={<DashboardSkeleton />}><StudentDashboard /></Suspense>\r\n              </RoleRoute>\r\n            </PrivateRoute>\r\n          } />\r\n          <Route path=\"/student/lab\" element={\r\n            <PrivateRoute>\r\n              <RoleRoute requiredRole=\"student\">\r\n                <Suspense fallback={<LabSkeleton />}><Lab3D /></Suspense>\r\n              </RoleRoute>\r\n            </PrivateRoute>\r\n          } />\r\n          \r\n          {/* Shared authenticated routes (mostly student-centric for now) */}\r\n          <Route path=\"/lab\" element={<PrivateRoute><Suspense fallback={<LoadingOverlay />}><Lab /></Suspense></PrivateRoute>} />\r\n          <Route path=\"/result\" element={<PrivateRoute><Suspense fallback={<LoadingOverlay />}><Result /></Suspense></PrivateRoute>} />\r\n          <Route path=\"/titration\" element={<PrivateRoute><Suspense fallback={<LoadingOverlay />}><Titration /></Suspense></PrivateRoute>} />\r\n          <Route path=\"/organic\" element={<PrivateRoute><Suspense fallback={<LoadingOverlay />}><Organic /></Suspense></PrivateRoute>} />\r\n          <Route path=\"/inorganic\" element={<PrivateRoute><Suspense fallback={<LoadingOverlay />}><Inorganic /></Suspense></PrivateRoute>} />\r\n          <Route path=\"/history\" element={<PrivateRoute><Suspense fallback={<LoadingOverlay />}><History /></Suspense></PrivateRoute>} />\r\n          <Route path=\"/profile\" element={<PrivateRoute><Suspense fallback={<LoadingOverlay />}><Profile /></Suspense></PrivateRoute>} />\r\n          <Route path=\"/success\" element={<PrivateRoute><Suspense fallback={<LoadingOverlay />}><Success /></Suspense></PrivateRoute>} />\r\n\r\n          {/* Teacher-only routes */}\r\n          <Route path=\"/teacher\" element={\r\n            <PrivateRoute>\r\n              <RoleRoute requiredRole=\"teacher\">\r\n                <Suspense fallback={<DashboardSkeleton />}><TeacherDashboard /></Suspense>\r\n              </RoleRoute>\r\n            </PrivateRoute>\r\n          } />\r\n          <Route path=\"/teacher/analytics\" element={\r\n            <PrivateRoute>\r\n              <RoleRoute requiredRole=\"teacher\">\r\n                <Suspense fallback={<DashboardSkeleton />}><TeacherDashboard analytics /></Suspense>\r\n              </RoleRoute>\r\n            </PrivateRoute>\r\n          } />\r\n          {/* Placeholder for classroom detail (Iteration 11) */}\r\n          <Route path=\"/teacher/classroom/:id\" element={\r\n            <PrivateRoute>\r\n              <RoleRoute requiredRole=\"teacher\">\r\n                <Suspense fallback={<LoadingOverlay />}><ClassroomDetail /></Suspense>\r\n              </RoleRoute>\r\n            </PrivateRoute>\r\n          } />\r\n\r\n          {/* Redirect root based on role */}\r\n          <Route path=\"/\" element={<RootRedirect />} />\r\n          {/* Catch-all redirect to root */}\r\n          <Route path=\"*\" element={<Navigate to=\"/\" replace />} />\r\n        </Routes>\r\n        </AnimatePresence>\r\n      </div>\r\n    </ErrorBoundary >\r\n  );\r\n}\r\n\r\nexport default App;\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\rishit\\OneDrive\\Desktop\\Project\\Alchemistry - Antigravity\\Alchemistry-master\\client\\src\\components\\3d-animations\\CanvasContainer.jsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\rishit\\OneDrive\\Desktop\\Project\\Alchemistry - Antigravity\\Alchemistry-master\\client\\src\\components\\3d-animations\\DraggableFlask.jsx","messages":[],"suppressedMessages":[{"ruleId":"react-hooks/immutability","severity":2,"message":"Error: This value cannot be modified\n\nModifying a value returned from a hook is not allowed. Consider moving the modification into the hook where the value is constructed.\n\n  43 |         \n  44 |         // eslint-disable-next-line react-hooks/immutability\n> 45 |         gl.domElement.style.cursor = 'grabbing';\n     |         ^^^^^^^^^^^^^^^^^^^ `gl` cannot be modified\n  46 |         dragActive.current = true;\n  47 |\n  48 |         // Calculate intersection on the XY plane","line":45,"column":9,"nodeType":null,"endLine":45,"endColumn":28,"suppressions":[{"kind":"directive","justification":""}]},{"ruleId":"react-hooks/immutability","severity":2,"message":"Error: This value cannot be modified\n\nModifying a value returned from a hook is not allowed. Consider moving the modification into the hook where the value is constructed.\n\n   97 |\n   98 |         // eslint-disable-next-line react-hooks/immutability\n>  99 |         gl.domElement.style.cursor = 'grab';\n      |         ^^^^^^^^^^^^^^^^^^^ `gl` cannot be modified\n  100 |         dragActive.current = false;\n  101 |         isPouring.current = false;\n  102 |         isTilted.current = false;","line":99,"column":9,"nodeType":null,"endLine":99,"endColumn":28,"suppressions":[{"kind":"directive","justification":""}]}],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"