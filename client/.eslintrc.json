{
    "extends": [
        "eslint:recommended",
        "plugin:react/recommended",
        "plugin:react-hooks/recommended",
        "plugin:jsx-a11y/recommended",
        "prettier"
    ],
    "parserOptions": {
        "ecmaVersion": 2022,
        "sourceType": "module",
        "ecmaFeatures": {
            "jsx": true
        }
    },
    "env": {
        "browser": true,
        "es2022": true,
        "node": true
    },
    "rules": {
        "no-console": "warn",
        "react/prop-types": "off",
        "react/react-in-jsx-scope": "off",
        "jsx-a11y/click-events-have-key-events": "warn",
        "jsx-a11y/no-static-element-interactions": "warn",
        "react/no-unknown-property": [
            "error",
            {
                "ignore": [
                    "position",
                    "rotation",
                    "args",
                    "attach",
                    "object",
                    "geometry",
                    "material",
                    "intensity",
                    "castShadow",
                    "receiveShadow",
                    "dispose",
                    "roughness",
                    "metalness",
                    "transparent",
                    "angle",
                    "penumbra",
                    "uColor",
                    "visible",
                    "depthWrite",
                    "array",
                    "count",
                    "itemSize",
                    "vertexColors",
                    "sizeAttenuation",
                    "blending"
                ]
            }
        ]
    },
    "overrides": [
        {
            "files": [
                "**/*.test.js",
                "**/*.spec.js"
            ],
            "rules": {
                "no-unused-vars": "off"
            }
        }
    ],
    "settings": {
        "react": {
            "version": "detect"
        }
    }
}