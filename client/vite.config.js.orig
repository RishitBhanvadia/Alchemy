            reporter: ['text', 'json', 'html', 'lcov', 'cobertura'],
            exclude: [
                'node_modules/',
                'src/test/',
                '**/*.config.js',
                '**/dist/**',
            ],
        },
        server: {
            deps: {
                inline: ['@exodus/bytes', 'html-encoding-sniffer']
