# Server Configuration
PORT=5000
NODE_ENV=development

# Supabase - Server uses SERVICE key (keep this PRIVATE, never commit)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Frontend - for CORS allowlist
FRONTEND_URL=https://your-frontend-domain.com

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key-here

# Zoom Server-to-Server OAuth (required for Zoom meeting creation)
ZOOM_ACCOUNT_ID=your-zoom-account-id
ZOOM_CLIENT_ID=your-zoom-client-id
ZOOM_CLIENT_SECRET=your-zoom-client-secret

# Google OAuth (required for Google Meet creation via Calendar API)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Rate limiting (optional override)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=100
