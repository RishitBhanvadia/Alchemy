# Server Configuration
PORT=5000
NODE_ENV=development

# Supabase Configuration
# SUPABASE_URL: Your Supabase project URL (e.g., https://xyz.supabase.co)
SUPABASE_URL=

# SUPABASE_KEY: The public anon key (for client-side access, if needed by server) or service role key (for administrative tasks)
# In production, use the service role key for backend operations that bypass RLS.
SUPABASE_KEY=

# SUPABASE_SERVICE_KEY: The service role key for administrative tasks (migrations, etc.) - DO NOT SHARE
SUPABASE_SERVICE_KEY=
